# Stored on the Azure VM as /etc/libif/.env.production. Never commit real values.
COMPOSE_PROJECT_NAME=libif-production

# The backend hostname points to the Azure VM. LIBIF_HOSTNAME remains required by
# the base Compose file and intentionally has the same value.
LIBIF_HOSTNAME=api.library.example.edu
LIBIF_API_HOSTNAME=api.library.example.edu
LIBIF_ACME_EMAIL=admin@example.edu

# Vercel must use a custom hostname under the same registrable domain when the
# application relies on SameSite session cookies.
LIBIF_WEB_BASE_URL=https://library.example.edu
# Optional comma-separated preview origins. Do not use a wildcard.
LIBIF_CORS_ORIGINS=
LIBIF_SESSION_COOKIE_DOMAIN=

POSTGRES_USER=library
POSTGRES_DB=libif
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://library:change-me-database-password@postgres:5432/libif?schema=public

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

MINIO_ROOT_USER=replace-with-a-random-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-secret-key
S3_REGION=us-east-1
S3_BUCKET=libif-pdfs

LIBIF_SOURCE_ACCESS_TOKEN_SECRET=replace-with-an-independent-random-secret

OCR_LANGUAGES=vie+eng
OCR_COMMAND_TIMEOUT_MS=60000
OCR_MAX_PAGES=50
OCR_RENDER_DPI=200
OCR_TEMP_STALE_AGE_MS=3600000

READER_PAGE_RATE_LIMIT_PER_MIN=60
READER_IMPOSSIBLE_RATE_PER_MIN=120
READER_MAX_CONCURRENT_SESSIONS=3
READER_MAX_INVALID_PROBES=8

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=starttls
