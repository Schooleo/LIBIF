COMPOSE_PROJECT_NAME=libif-staging

# Staging pulls only full-SHA images published after successful main-branch CI.
LIBIF_GHCR_NAMESPACE="schooleo"
LIBIF_STAGING_RELEASE_SHA="replace-with-40-character-main-commit-sha"

# Must match the public Funnel URL derived from TAILSCALE_HOSTNAME and the
# tailnet DNS name. Do not include a trailing slash.
LIBIF_STAGING_BASE_URL="https://libif-staging.example-tailnet.ts.net"

POSTGRES_USER="library"
POSTGRES_PASSWORD="replace-with-a-long-random-postgres-password"
POSTGRES_DB="libif"
REDIS_PASSWORD="replace-with-a-long-random-redis-password"
MINIO_ROOT_USER="replace-with-a-random-minio-access-key"
MINIO_ROOT_PASSWORD="replace-with-a-long-random-minio-secret-key"
S3_REGION="us-east-1"
S3_BUCKET="libif-pdfs"
LIBIF_SOURCE_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-bytes"

# Demonstration account passwords used only by `make staging-seed`.
STAGING_ADMIN_PASSWORD="replace-with-a-unique-admin-passphrase"
STAGING_LIBRARIAN_PASSWORD="replace-with-a-unique-librarian-passphrase"
STAGING_READER_PASSWORD="replace-with-a-unique-reader-passphrase"
STAGING_READER2_PASSWORD="replace-with-a-unique-second-reader-passphrase"

# Use a reusable, non-ephemeral auth key authorized for the staging Funnel
# node. Keep the resulting Tailscale state volume between restarts.
TAILSCALE_AUTHKEY="tskey-auth-replace-with-staging-key"
TAILSCALE_HOSTNAME="libif-staging"

# Optional comma-separated additional origins. Leave empty for same-origin use.
LIBIF_CORS_ORIGINS=

# Optional email delivery for password-reset demonstrations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=starttls
