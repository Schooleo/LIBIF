# Copy to .env.production, replace every placeholder, and keep that file private.
COMPOSE_PROJECT_NAME=libif-production

# Public DNS A/AAAA record must point to this VPS before Caddy starts.
LIBIF_HOSTNAME=library.example.edu
LIBIF_ACME_EMAIL=admin@example.edu

POSTGRES_USER=library
POSTGRES_DB=libif
POSTGRES_PASSWORD=change-me-database-password
# URL-encode special characters in credentials used inside connection URLs.
DATABASE_URL=postgresql://library:change-me-database-password@postgres:5432/libif?schema=public

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

MINIO_ROOT_USER=replace-with-a-random-storage-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-secret-key
S3_REGION=us-east-1
S3_BUCKET=libif-pdfs

# Generate independently, for example: openssl rand -base64 48
LIBIF_SOURCE_ACCESS_TOKEN_SECRET=replace-with-an-independent-random-secret

# Optional additional origins, comma-separated. Same-origin production needs none.
LIBIF_CORS_ORIGINS=
LIBIF_SESSION_COOKIE_DOMAIN=

OCR_LANGUAGES=vie+eng
OCR_COMMAND_TIMEOUT_MS=60000
OCR_MAX_PAGES=50
OCR_RENDER_DPI=200
OCR_TEMP_STALE_AGE_MS=3600000

READER_PAGE_RATE_LIMIT_PER_MIN=60
READER_IMPOSSIBLE_RATE_PER_MIN=120
READER_MAX_CONCURRENT_SESSIONS=3
READER_MAX_INVALID_PROBES=8

# Optional password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=starttls

# Optional immutable registry images. Defaults build from this checkout.
# LIBIF_API_IMAGE=ghcr.io/owner/libif-api:release-sha
# LIBIF_WEB_IMAGE=ghcr.io/owner/libif-web:release-sha
# LIBIF_MIGRATE_IMAGE=ghcr.io/owner/libif-migrate:release-sha
